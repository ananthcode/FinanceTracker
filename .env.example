# Finance Tracker — environment configuration (contracts/client-shell.md §Configuration)
# Copy to .env.local (never commit real values). One set of values per environment (demo | live).

# ---- Environment ----
APP_ENV=demo
WEB_BASE_URL=http://localhost:3000

# ---- Web (Next.js) — publishable values only in NEXT_PUBLIC_* ----
NEXT_PUBLIC_APP_ENV=demo
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# ---- Server only (never prefix with NEXT_PUBLIC_ or EXPO_PUBLIC_) ----
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# ---- Mobile (Expo) — publishable values only ----
EXPO_PUBLIC_APP_ENV=demo
EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000

# ---- Owner-admin designation (scripts/env-bootstrap.ts) ----
OWNER_EMAIL=owner@example.com

# ---- Email (SMTP) — local dev uses Supabase's Mailpit on port 54325 ----
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Finance Tracker <no-reply@example.com>"

# ---- Android App Links (assetlinks.json) ----
ANDROID_APP_ID=com.example.financetracker.demo
ANDROID_CERT_SHA256=00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00

# ---- Local testing only ----
# IDLE_MINUTES=1
