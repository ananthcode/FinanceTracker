!apps/mobile/modules/*/android/
*.apk
*.aab
*.keystore
*.jks

# ---- Supabase local ----
supabase/.branches/
supabase/.temp/

# ---- OS / editor ----
.DS_Store
Thumbs.db
desktop.ini
